# Copy to ".env" and adjust as needed. These override defaults in config.py.
# (config.py reads real environment variables; loading .env into the environment
#  is left to your shell / Docker / process manager.)

# Absolute path to the Task09_Spleen dataset (contains imagesTr/, labelsTr/).
# SURGIVISION_DATA_ROOT=/abs/path/to/Task09_Spleen

# Directory holding trained model checkpoints.
# SURGIVISION_MODELS_DIR=/abs/path/to/models

# Explicit checkpoint paths (default to files inside SURGIVISION_MODELS_DIR).
# SURGIVISION_AUTOENCODER_PATH=/abs/path/to/best_spleen_3d_autoencoder.pth
# SURGIVISION_HYBRID_MODEL_PATH=/abs/path/to/best_hybrid_detector.pth
